{
  "module": {
    "name": "entry_wearable",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryWearableAbility",
    "deviceTypes": [
      "wearable"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryWearableAbility",
        "srcEntry": "./ets/entryability/EntryWearableAbility.ets",
        "description": "$string:EntryWearableAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryWearableAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "startWindow": "$profile:start_window",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "WearableBackupAbility",
        "srcEntry": "./ets/wearablebackupability/WearableBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      },
      {
        "name": "WearableFormAbility",
        "srcEntry": "./ets/wearableformability/WearableFormAbility.ets",
        "description": "$string:WearableFormAbility_desc",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.VIBRATE"
      }
    ]
  }
}
