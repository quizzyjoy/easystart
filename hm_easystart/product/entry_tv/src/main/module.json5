{
  "module": {
    "querySchemes": [
      "appmarket",
      "https"
    ],
    "name": "entry_tv",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryTvAbility",
    "deviceTypes": [
      "tv"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryTvAbility",
        "srcEntry": "./ets/entryability/EntryTvAbility.ets",
        "description": "$string:EntryTvAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryTvAbility_label",
        "startWindowIcon": "$media:foreground",
        "startWindowBackground": "$color:qj_brand",
        "startWindow": "$profile:start_window",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.VIBRATE"
      }
    ]
  }
}
