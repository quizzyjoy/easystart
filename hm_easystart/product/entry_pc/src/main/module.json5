{
  "module": {
    "querySchemes": [
      "appmarket",
      "https"
    ],
    "name": "entry_pc",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "PcAbility",
    "deviceTypes": [
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "PcAbility",
        "srcEntry": "./ets/pcability/PcAbility.ets",
        "description": "$string:PcAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:PcAbility_label",
        "startWindowIcon": "$media:foreground",
        "startWindowBackground": "$color:qj_brand",
        "startWindow": "$profile:start_window",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "PcBackupAbility",
        "srcEntry": "./ets/pcbackupability/PcBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      },
      {
        "name": "PcFormAbility",
        "srcEntry": "./ets/pcformability/PcFormAbility.ets",
        "description": "$string:PcFormAbility_desc",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": {
          "abilities": ["PcAbility"],
          "when": "inuse"
        }
      }
    ]
  }
}
